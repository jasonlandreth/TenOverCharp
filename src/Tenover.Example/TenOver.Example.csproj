<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>tenover-example</AssemblyName>
    <RootNamespace>TenOver.Example</RootNamespace>
    <Description>Connect to a Garmin R10 over BLE and print shot data to the console.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TenOver\TenOver.csproj" />
  </ItemGroup>

  <ItemGroup>
   <PackageReference Include="log4net" Version="3.4.0-preview.1" />
    <PackageReference Include="log4net.Ext.Json" Version="3.0.3" />
    <PackageReference Include="log4net.Ext.Json.Net" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
  <None Include="log4net.config" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>
</Project>

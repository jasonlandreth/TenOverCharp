<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TenOver</AssemblyName>
    <RootNamespace>TenOver</RootNamespace>
    <Description>Client library for the Garmin R10 launch monitor BLE/GFDI/protobuf protocol (C# port of 10over)</Description>
    <Version>0.0.3</Version>
  </PropertyGroup>
<!-- In Tenover.csproj -->
<ItemGroup>
  <InternalsVisibleTo Include="Tenover.Example" />
  <InternalsVisibleTo Include="TenOver.WinForm.Example" />
</ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.0-rc2" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <PackageReference Include="InTheHand.BluetoothLE" Version="4.0.44" />
    <PackageReference Include="log4net" Version="3.4.0-preview.1" />
    <PackageReference Include="log4net.Ext.Json" Version="3.0.3" />
    <PackageReference Include="log4net.Ext.Json.Net" Version="3.0.3" />
  </ItemGroup>
  <!-- Proto files — all three are in the same folder so imports resolve without extra flags -->
  <ItemGroup>
    <Protobuf Include="proto\GDISmart.proto" GrpcServices="None" ProtoRoot="proto" />
    <Protobuf Include="proto\GDIEventSharing.proto" GrpcServices="None" ProtoRoot="proto" />
    <Protobuf Include="proto\GDILaunchMonitor.proto" GrpcServices="None" ProtoRoot="proto" />
  </ItemGroup>
</Project>
